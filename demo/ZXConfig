zxconfig 1.1
export_with_prefix ""
presets_dir "presets"

# ZXConfig stress laboratory.  All includes exist even when hidden.
# Shared macros are imported before the subsystem files that invoke them.
include "macros.zx"

menu "Stress laboratory: ${BenchProject} / ${arch.BenchTarget}" {
    menu "Workload controls" {
        option BenchProject : string = "zxconfig-stress" {
            label "Project name (changes labels throughout the tree)"
            help "Edit this value, then search for a device to see live interpolation."
            pattern "^[A-Za-z0-9_-]+$"
            tags ["control", "interpolation"]
        }
        option BenchRun : bool = true {
            label "Enable subsystem workload"
            help "Turning this off hides the subsystem forests while retaining values."
        }
        option BenchExpert : bool = false {
            label "Expose expert settings and deep nesting"
        }
        option BenchFastPath : bool = true { label "Global fast path" }
        option BenchMemoryMiB : int = 8192 { range 256 .. 1048576 }
        option BenchWorkers : int = 8 { range 1 .. 1024 }
        option BenchChecks : set = {bounds, verify} {
            choices bounds | trace | verify | audit
            label "Global validation features"
        }
        option BenchPreempt : enum = voluntary {
            choices none | voluntary | full | realtime
            label "Global scheduling policy"
        }
        option BenchHz : int {
            range 100 .. 2000
            default { 1000 when BenchPreempt == full or BenchPreempt == realtime 250 }
        }
        option BenchKernelVersion : string = "7.0.0-stress" {
            pattern "^[0-9]+\\.[0-9]+\\.[0-9]+"
        }
        option BenchSysroot : path = "." { path must_exist | is_dir }
        option BenchCflags : list<string> = ["-O2", "-Wall", "-Wextra"]
        option BenchAlert : bool = false {
            label "Trigger advisory messages intentionally"
            warn BenchAlert : "Stress warning: ${BenchProject} requested an advisory"
        }
    }

    include "arch.zx"

    menu "Host probes and derived state" {
        computed BenchHostOs : string = HOST_OS
        computed BenchHostArch : string = HOST_ARCH
        computed BenchHostKernel : string = HOST_KERNEL
        computed BenchHostNode : string = HOST_NODE
        option BenchBuildUser : string = env("USER") fallback "builder"
        computed BenchHostQuery : string = HOST_OS == "Linux"
            ? shell("printf '%s' linux-query") : shell("printf '%s' portable-query")
        computed BenchFailedProbe : string = shell("exit 1") fallback "expected-fallback"
        computed BenchArtifact : string = "${BenchProject}-${arch.BenchTarget}"
        computed BenchMemoryPerWorker : int = BenchMemoryMiB / BenchWorkers
        computed BenchHasChecks : bool = contains(BenchChecks, bounds)
        computed BenchChecksType : string = type_of(BenchChecks)
        computed BenchLinkBase : hex = arch.BenchBaseAddress
    }

    menu "Subsystem forests" visible BenchRun {
        include "drivers.zx"
        include "subsystems/network.zx"
        include "subsystems/storage.zx"
        include "subsystems/filesystems.zx"
        include "subsystems/memory.zx"
        include "subsystems/scheduler.zx"
        include "subsystems/security.zx"
        include "subsystems/virtualization.zx"
        include "subsystems/tracing.zx"
        include "subsystems/power.zx"
        include "subsystems/ipc.zx"
        include "subsystems/runtime.zx"
    }

    menu "Dependency and recursion laboratories" {
        include "dependencies.zx"
        include "recursion.zx"
        include "deep.zx"
    }
}

error BenchMemoryMiB < BenchWorkers * 128 : "Memory must cover workers x 128 MiB"
error dep.Chain0256 != 256 : "The dependency chain must reach its final value"
error recursive.RecRoot_N_N_N_N_N_N_N_N_N_N_N_NValue != 12 : "Recursive terminal is wrong"
error BenchFailedProbe != "expected-fallback" : "Probe fallback must remain deterministic"
warn contains(BenchChecks, audit) and not BenchExpert : "Auditing is enabled without the expert switch"
warn BenchAlert : "Intentional global stress advisory"

alias QuickTarget = arch.BenchTarget
alias QuickNetwork = net.NetA_AD0Enabled
deprecated OLD_WORKERS -> BenchWorkers {
    message "OLD_WORKERS migrated to BenchWorkers"
}

generate header "out/config.h"
generate makefile "out/config.mk"
generate json "out/config.json"
generate cmake "out/config.cmake"
generate template "out/linker.ld" from "linker.ld.tpl"
